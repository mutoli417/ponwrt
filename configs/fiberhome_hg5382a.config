# AN758x PonWrt 单机型精简配置（diffconfig）—— 使用前必须 make defconfig 展开
# profile      : fiberhome_hg5382a
# 机型         : 烽火 HG5382A
# SoC          : AN7581
# 硬件要点     : XG-PON 网关，无 WiFi
# 光器件       : GN28L95 / UX3363（分页式 BOSA）
# 网口 PHY     : MaxLinear GPY211（2500base-x）
# 无线         : 无
# USB          : 无 USB
# 校准/身份数据: factory
#
# 源码         : pbs05/ponwrt（ImmortalWrt + Airoha AN758x PON），分支 master
# 内核         : 6.18    包管理：apk + 全量签名
# 组件来源     : ImmortalWrt feeds（packages / luci）+ pon_drivers / pon_userspace
#               网络栈全部走 nftables（firewall4 + kmod-nft-*），不引入 iptables / OpenWrt 官方 feed 包
#
# ⚠ 精简配置只写与基座的差异，必须 make defconfig 展开后才能 make
#=========================================================================

CONFIG_TARGET_airoha=y
CONFIG_TARGET_airoha_an7581=y
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_PER_DEVICE_ROOTFS=y
CONFIG_LINUX_6_18=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_ROOTFS_INITRAMFS=y
CONFIG_TARGET_UBIFS_FREE_SPACE_FIXUP=y
CONFIG_JSON_OVERVIEW_IMAGE_INFO=y

#=========================================================================
# DEVICES —— 只编这一个机型
#=========================================================================
CONFIG_TARGET_DEVICE_airoha_an7581_DEVICE_fiberhome_hg5382a=y
CONFIG_TARGET_DEVICE_PACKAGES_airoha_an7581_DEVICE_fiberhome_hg5382a=""

#=========================================================================
# apk 包管理（ImmortalWrt 24.10+ 默认，替代 opkg）+ 全量签名
#=========================================================================
CONFIG_USE_APK=y
CONFIG_SIGNED_PACKAGES=y
CONFIG_SIGNATURE_CHECK=y
CONFIG_DOWNLOAD_CHECK_CERTIFICATE=y
CONFIG_SIGN_EACH_PACKAGE=y
CONFIG_SIGN_FIRMWARE=y

#=========================================================================
# 编译与内核选项
#=========================================================================
CONFIG_DEVEL=y
CONFIG_BUSYBOX_CUSTOM=y
CONFIG_PKG_FORTIFY_SOURCE_1=y
CONFIG_PKG_RELRO_FULL=y
CONFIG_PKG_DT_RELR=y
CONFIG_PKG_CHECK_FORMAT_SECURITY=y
CONFIG_PKG_ASLR_PIE_REGULAR=y
CONFIG_PKG_CC_STACKPROTECTOR_REGULAR=y
CONFIG_KERNEL_CC_STACKPROTECTOR_REGULAR=y
CONFIG_KERNEL_STACKPROTECTOR=y
CONFIG_USE_SSTRIP=y
CONFIG_SSTRIP_DISCARD_TRAILING_ZEROES=y
CONFIG_KERNEL_CC_OPTIMIZE_FOR_PERFORMANCE=y
CONFIG_MOLD=y
CONFIG_IPV6=y
CONFIG_KERNEL_IPV6=y

#=========================================================================
# 1. PON 内核驱动 —— 光口链路核心，缺一个 pon 口就不通
#=========================================================================
CONFIG_PACKAGE_kmod-airoha-xpon=y
CONFIG_PACKAGE_kmod-airoha-pon-frontend=y

#=========================================================================
# 2. PON 用户态 —— 守护进程与工具
#=========================================================================
CONFIG_PACKAGE_airoha-pond=y
CONFIG_PACKAGE_airoha-ponctl=y
CONFIG_PACKAGE_airoha-pon-debug=y

#=========================================================================
# 3. PON / IPTV 的 LuCI 界面
#=========================================================================
CONFIG_PACKAGE_luci-app-pon=y
CONFIG_PACKAGE_luci-i18n-pon-zh-cn=y
CONFIG_PACKAGE_luci-app-iptv=y
CONFIG_PACKAGE_luci-i18n-iptv-zh-cn=y

#=========================================================================
# 4. 网络转发 / nftables —— 全部走 nft，不引入 iptables
#=========================================================================
CONFIG_PACKAGE_kmod-nft-core=y
CONFIG_PACKAGE_kmod-nft-nat=y
CONFIG_PACKAGE_kmod-nft-bridge=y
CONFIG_PACKAGE_kmod-nft-fib=y
CONFIG_PACKAGE_kmod-nft-socket=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-nft-fullcone=y
CONFIG_PACKAGE_kmod-nf-nat=y
CONFIG_PACKAGE_kmod-nf-socket=y
CONFIG_PACKAGE_kmod-nf-tproxy=y
CONFIG_PACKAGE_kmod-nf-conntrack=y
CONFIG_PACKAGE_kmod-nf-conntrack-netlink=y
CONFIG_PACKAGE_kmod-nf-conntrack-bridge=y
CONFIG_PACKAGE_kmod-nf-flow=y
CONFIG_PACKAGE_kmod-nft-offload=y
CONFIG_PACKAGE_kmod-nf-log=y
CONFIG_PACKAGE_kmod-nf-log6=y
CONFIG_PACKAGE_kmod-nf-reject=y
CONFIG_PACKAGE_kmod-nf-reject6=y
CONFIG_PACKAGE_kmod-nfnetlink=y
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_kmod-netlink-diag=y

#=========================================================================
# 5. 隧道与拨号
#=========================================================================
CONFIG_PACKAGE_kmod-wireguard=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-udptunnel4=y
CONFIG_PACKAGE_kmod-udptunnel6=y
CONFIG_PACKAGE_kmod-macvlan=y
CONFIG_PACKAGE_kmod-ppp=y
CONFIG_PACKAGE_kmod-pppoe=y
CONFIG_PACKAGE_kmod-pppox=y
CONFIG_PACKAGE_kmod-slhc=y
CONFIG_PACKAGE_kmod-mppe=y
CONFIG_PACKAGE_kmod-ovpn-backports=y

#=========================================================================
# 6. LuCI 界面（ImmortalWrt 组件）
#=========================================================================
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-light=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-mod-network=y
CONFIG_PACKAGE_luci-mod-status=y
CONFIG_PACKAGE_luci-mod-system=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-package-manager=y
CONFIG_PACKAGE_luci-proto-ipv6=y
CONFIG_PACKAGE_luci-proto-ppp=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_luci-lib-nixio_openssl=y
CONFIG_PACKAGE_luci-lib-uqr=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-package-manager-zh-cn=y

# --- 硬件状态监控（由 diy-part1.sh 拉取 / 拷贝；AN758x 专属）---
CONFIG_PACKAGE_luci-app-airoha-npu=y
CONFIG_PACKAGE_luci-i18n-airoha-npu-zh-cn=y
CONFIG_PACKAGE_luci-app-pon-status=y
CONFIG_PACKAGE_luci-app-natmode=y

#=========================================================================
# 7. 基础服务 —— ImmortalWrt 默认栈
#=========================================================================
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_dnsmasq_full_dhcp=y
CONFIG_PACKAGE_dnsmasq_full_dhcpv6=y
CONFIG_PACKAGE_dnsmasq_full_dnssec=y
CONFIG_PACKAGE_dnsmasq_full_auth=y
CONFIG_PACKAGE_dnsmasq_full_nftset=y
CONFIG_PACKAGE_dnsmasq_full_conntrack=y
CONFIG_PACKAGE_dnsmasq_full_noid=y
CONFIG_PACKAGE_dnsmasq_full_tftp=y
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_nftables-json=y
CONFIG_PACKAGE_netifd=y
CONFIG_PACKAGE_odhcp6c=y
CONFIG_PACKAGE_odhcpd-ipv6only=y
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y
CONFIG_PACKAGE_dropbear=y
CONFIG_PACKAGE_uhttpd=y
CONFIG_PACKAGE_uhttpd-mod-ubus=y
CONFIG_PACKAGE_rpcd=y
CONFIG_PACKAGE_rpcd-mod-file=y
CONFIG_PACKAGE_rpcd-mod-luci=y
CONFIG_PACKAGE_rpcd-mod-rpcsys=y
CONFIG_PACKAGE_rpcd-mod-rrdns=y
CONFIG_PACKAGE_rpcd-mod-ucode=y
CONFIG_PACKAGE_conntrack=y
CONFIG_PACKAGE_autocore=y
CONFIG_PACKAGE_shellsync=y
CONFIG_PACKAGE_getrandom=y
CONFIG_PACKAGE_urandom-seed=y
CONFIG_PACKAGE_urngd=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_openwrt-keyring=y
CONFIG_PACKAGE_apk-openssl=y

#=========================================================================
# 8. 系统工具
#=========================================================================
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_ethtool-full=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_ip-bridge=y
CONFIG_PACKAGE_i2c-tools=y
CONFIG_PACKAGE_mtd=y
CONFIG_PACKAGE_nand-utils=y
CONFIG_PACKAGE_ubi-utils=y
CONFIG_PACKAGE_fitblk=y
CONFIG_PACKAGE_mount-utils=y
CONFIG_PACKAGE_busybox=y
CONFIG_PACKAGE_cgi-io=y
CONFIG_PACKAGE_uboot-envtools=y

#=========================================================================
# 9. 固件工具与签名
#=========================================================================
CONFIG_PACKAGE_fwtool=y
CONFIG_PACKAGE_usign=y
CONFIG_PACKAGE_fstools=y

#=========================================================================
# 10. 其他内核模块
#=========================================================================
CONFIG_PACKAGE_kmod-gpio-button-hotplug=y
CONFIG_PACKAGE_kmod-leds-gpio=y
CONFIG_PACKAGE_kmod-crypto-aead=y
CONFIG_PACKAGE_kmod-crypto-hash=y
CONFIG_PACKAGE_kmod-crypto-manager=y
CONFIG_PACKAGE_kmod-crypto-null=y
CONFIG_PACKAGE_kmod-crypto-sha1=y
CONFIG_PACKAGE_kmod-crypto-chacha20poly1305=y
CONFIG_PACKAGE_kmod-crypto-kpp=y
CONFIG_PACKAGE_kmod-crypto-lib-chacha20=y
CONFIG_PACKAGE_kmod-crypto-lib-chacha20poly1305=y
CONFIG_PACKAGE_kmod-crypto-lib-curve25519=y
CONFIG_PACKAGE_kmod-crypto-lib-poly1305=y
CONFIG_PACKAGE_kmod-lib-crc-ccitt=y
CONFIG_PACKAGE_kmod-tcp-bbr=y
CONFIG_PACKAGE_libbpf=y
CONFIG_PACKAGE_libelf=y

#=========================================================================
# 11. 基础库与运行时（IM 组件）
#=========================================================================
CONFIG_PACKAGE_base-files=y
CONFIG_PACKAGE_jsonfilter=y
CONFIG_PACKAGE_libatomic=y
CONFIG_PACKAGE_libc=y
CONFIG_PACKAGE_libgcc=y
CONFIG_PACKAGE_libpthread=y
CONFIG_PACKAGE_librt=y
CONFIG_PACKAGE_logd=y
CONFIG_PACKAGE_procd=y
CONFIG_PACKAGE_procd-seccomp=y
CONFIG_PACKAGE_procd-ujail=y
CONFIG_PACKAGE_ubox=y
CONFIG_PACKAGE_ubus=y
CONFIG_PACKAGE_ubusd=y
CONFIG_PACKAGE_uci=y
CONFIG_PACKAGE_ucode=y
CONFIG_PACKAGE_ucode-mod-digest=y
CONFIG_PACKAGE_ucode-mod-fs=y
CONFIG_PACKAGE_ucode-mod-html=y
CONFIG_PACKAGE_ucode-mod-log=y
CONFIG_PACKAGE_ucode-mod-math=y
CONFIG_PACKAGE_ucode-mod-ubus=y
CONFIG_PACKAGE_ucode-mod-uci=y
CONFIG_PACKAGE_ucode-mod-uloop=y
CONFIG_PACKAGE_libopenssl=y
CONFIG_PACKAGE_libustream-openssl=y
CONFIG_PACKAGE_jansson=y
CONFIG_PACKAGE_jshn=y
CONFIG_PACKAGE_libblobmsg-json=y
CONFIG_PACKAGE_libgmp=y
CONFIG_PACKAGE_libiperf3=y
CONFIG_PACKAGE_libjson-c=y
CONFIG_PACKAGE_libjson-script=y
CONFIG_PACKAGE_liblucihttp=y
CONFIG_PACKAGE_liblucihttp-ucode=y
CONFIG_PACKAGE_libmnl=y
CONFIG_PACKAGE_libnetfilter-conntrack=y
CONFIG_PACKAGE_libnetfilter-cthelper=y
CONFIG_PACKAGE_libnetfilter-cttimeout=y
CONFIG_PACKAGE_libnetfilter-queue=y
CONFIG_PACKAGE_libnettle=y
CONFIG_PACKAGE_libnfnetlink=y
CONFIG_PACKAGE_libnftnl=y
CONFIG_PACKAGE_libnl-tiny=y
CONFIG_PACKAGE_libpcap=y
CONFIG_PACKAGE_libpcre2=y
CONFIG_PACKAGE_libubox=y
CONFIG_PACKAGE_libubus=y
CONFIG_PACKAGE_libuci=y
CONFIG_PACKAGE_libuclient=y
CONFIG_PACKAGE_libucode=y
CONFIG_PACKAGE_libudebug=y
CONFIG_PACKAGE_zlib=y
CONFIG_PACKAGE_uclient-fetch=y
CONFIG_PACKAGE_wget-ssl=y

# --- tar / mac80211 特性开关（基座 defconfig 显式 =y，非 Kconfig 默认，必须写出）---
CONFIG_PACKAGE_TAR_POSIX_ACL=y
CONFIG_PACKAGE_TAR_XATTR=y
CONFIG_PACKAGE_TAR_BZIP2=y
CONFIG_PACKAGE_TAR_GZIP=y
CONFIG_PACKAGE_TAR_XZ=y
CONFIG_PACKAGE_TAR_ZSTD=y

#=========================================================================
# 12. 内核选项
#=========================================================================
CONFIG_KERNEL_AIO=y
CONFIG_KERNEL_CGROUPS=y
CONFIG_KERNEL_CGROUP_BPF=y
CONFIG_KERNEL_DEBUG_FS=y
CONFIG_KERNEL_DEBUG_INFO=y
CONFIG_KERNEL_DEBUG_INFO_REDUCED=y
CONFIG_KERNEL_FANOTIFY=y
CONFIG_KERNEL_IO_URING=y
CONFIG_KERNEL_IP_MROUTE=y
CONFIG_KERNEL_KALLSYMS=y
CONFIG_KERNEL_MAGIC_SYSRQ=y
CONFIG_KERNEL_MPTCP=y
CONFIG_KERNEL_NAMESPACES=y
CONFIG_KERNEL_NET_NS=y
CONFIG_KERNEL_SECCOMP=y
CONFIG_KERNEL_SECCOMP_FILTER=y
CONFIG_KERNEL_SWAP=y

#=========================================================================
# 13. 光器件驱动（BOSA）—— 两颗互斥，本机型已按硬件选定
#=========================================================================
CONFIG_PACKAGE_kmod-airoha-paged-bosa=y
# CONFIG_PACKAGE_kmod-airoha-en7572 is not set

#=========================================================================
# 14. 硬件卸载 —— NPU / PPE，PON 与以太网共用 ★每机型必开
#=========================================================================
CONFIG_PACKAGE_airoha-en7581-npu-firmware=y
# CONFIG_PACKAGE_airoha-an7583-npu-firmware is not set

#=========================================================================
# 15. WiFi —— 本机型无无线（DTS 无 PCIe 无线节点），全部关闭
#=========================================================================
# CONFIG_PACKAGE_kmod-mt76-core is not set
# CONFIG_PACKAGE_kmod-mt76-connac is not set
# CONFIG_PACKAGE_kmod-mt7915e is not set
# CONFIG_PACKAGE_kmod-mt7916-firmware is not set
# CONFIG_PACKAGE_kmod-mac80211 is not set
# CONFIG_PACKAGE_kmod-cfg80211 is not set
# CONFIG_PACKAGE_wpad-openssl is not set
# CONFIG_PACKAGE_hostapd-common is not set
# CONFIG_PACKAGE_wireless-regdb is not set
# CONFIG_PACKAGE_iw is not set
# CONFIG_PACKAGE_iwinfo is not set

#=========================================================================
# 16. USB 与存储 —— 本机型：无（无 USB）
#=========================================================================
# CONFIG_PACKAGE_kmod-usb-core is not set
# CONFIG_PACKAGE_kmod-usb-xhci-hcd is not set
# CONFIG_PACKAGE_kmod-usb-xhci-mtk is not set
# CONFIG_PACKAGE_kmod-usb3 is not set
# CONFIG_PACKAGE_kmod-usb-storage is not set
# CONFIG_PACKAGE_kmod-usb-storage-uas is not set
# CONFIG_PACKAGE_kmod-usb-ledtrig-usbport is not set
# CONFIG_PACKAGE_kmod-scsi-core is not set
# CONFIG_PACKAGE_block-mount is not set
# CONFIG_PACKAGE_blkid is not set
# CONFIG_PACKAGE_lsblk is not set
# CONFIG_PACKAGE_fdisk is not set
# CONFIG_PACKAGE_e2fsprogs is not set
# CONFIG_PACKAGE_exfat-mkfs is not set
# CONFIG_PACKAGE_kmod-fs-ext4 is not set
# CONFIG_PACKAGE_kmod-fs-exfat is not set
# CONFIG_PACKAGE_kmod-fs-vfat is not set

#=========================================================================
# 17. 2.5G PHY —— DTS 为 maxlinear,gpy211
#=========================================================================
CONFIG_PACKAGE_kmod-phy-maxlinear=y
# CONFIG_PACKAGE_kmod-phy-airoha-en8811h is not set
# CONFIG_PACKAGE_airoha-en8811h-firmware is not set
# CONFIG_PACKAGE_kmod-phy-realtek is not set
# CONFIG_PACKAGE_rtl826x-firmware is not set

#=========================================================================
# 18. 引导与固件 —— TF-A BL2 / BL31（AN7581）
#=========================================================================
CONFIG_PACKAGE_trusted-firmware-a-an7581-bl2=y
CONFIG_PACKAGE_trusted-firmware-a-an7581-bl31=y

#=========================================================================
# 19. 可选插件
#=========================================================================
CONFIG_PACKAGE_luci-app-ssr-plus=y
CONFIG_PACKAGE_luci-i18n-ssr-plus-zh-cn=y

CONFIG_PACKAGE_luci-compat=y
