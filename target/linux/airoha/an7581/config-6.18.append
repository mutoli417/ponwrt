#
# CPU idle (PSCI) - conservative: enable the cpuidle framework and expose a
# single light CPU retention state. No deep power-down / cluster power-collapse
# state is defined here.
# DT_IDLE_STATES and CPU_IDLE_MULTIPLE_DRIVERS are selected automatically by
# CONFIG_ARM_PSCI_CPUIDLE; do not add them manually.
#
CONFIG_CPU_IDLE=y
CONFIG_ARM_PSCI_CPUIDLE=y
CONFIG_CPU_IDLE_GOV_MENU=y
